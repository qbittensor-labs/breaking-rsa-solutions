+template<typename relation_type>
+static blockmatrix big_character_matrix(
+        std::vector<alg_prime_t> const & chars,
+        const char * purgedname,
+        cxx_cado_poly const & cpoly,
+        int nthreads)
+{
+    uint64_t nrows_hdr, ncols_hdr;
+    purgedfile_read_firstline (purgedname, &nrows_hdr, &ncols_hdr);
+    blockmatrix res(nrows_hdr, chars.size());
+    res.set_zero();
+    uint64_t const nrows = res.nrows();
+
+    fmt::print(stderr, "Reading {} pairs from {} and computing {} characters"
+            " [parallel reader, {} threads]\n",
+            nrows, purgedname, chars.size(), nthreads);
+
+    double const t0 = wct_seconds();
+    constexpr size_t CHUNK = 8U << 20;
+    size_t const nbufs = 2 * (size_t) nthreads + 2;
+
+    bqueue<std::unique_ptr<chunk>> todo, pool;
+    for (size_t i = 0; i < nbufs; i++)
+        pool.put(std::make_unique<chunk>());
+
+    std::atomic<uint64_t> overflow { 0 };
+
+    auto worker = [&]() {
+        std::unique_ptr<chunk> C;
+        relation_type rel;
+        while (todo.get(C)) {
+            char const * p = C->buf.get();
+            char const * const e = p + C->len;
+            uint64_t num = C->base;
+            while (p < e) {
+                char const * nl = (char const *) memchr(p, '\n', e - p);
+                if (is_rel_line(*p)) {
+                    if (num >= nrows) {
+                        overflow++;
+                    } else {
+                        unsigned char const * it = (unsigned char const *) p;
+                        rel.parse(it);
+                        rel.num = num;
+                        for(size_t cg = 0 ; cg < chars.size() ; cg+=64)
+                            res[rel.num][cg] = eval_64chars(rel, chars.data() + cg, cpoly);
+                    }
+                    num++;
+                }
+                if (!nl) break;
+                p = nl + 1;
+            }
+            ASSERT_ALWAYS(num == C->base + C->nrels);
+            C->len = 0;
+            pool.put(std::move(C));
+        }
+    };
+
+    std::vector<std::thread> workers;
+    workers.reserve(nthreads);
+    for (int i = 0; i < nthreads; i++)
+        workers.emplace_back(worker);
+
+    /* producer: inflate, cut at line boundaries, number the relations */
+    gz_reader G(purgedname);
+    std::vector<char> carry;
+    uint64_t nrels = 0;
+    for (bool eof = false; !eof; ) {
+        std::unique_ptr<chunk> C;
+        pool.get(C);
+        C->len = 0;
+        C->reserve(std::max(CHUNK, 2 * carry.size()));
+        if (!carry.empty()) {
+            memcpy(C->buf.get(), carry.data(), carry.size());
+            C->len = carry.size();
+            carry.clear();
+        }
+        size_t cut;
+        for (;;) {
+            size_t const want = C->cap - C->len;
+            size_t const got = G.read(C->buf.get() + C->len, want);
+            C->len += got;
+            if (got < want) eof = true;
+            char const * last = nullptr;
+            for (size_t k = C->len; k-- > 0; )
+                if (C->buf[k] == '\n') { last = C->buf.get() + k; break; }
+            if (eof) {
+                cut = C->len;
+                if (C->len && C->buf[C->len - 1] != '\n') {
+                    /* RSA-530: well-formed purge output always ends with a newline; a missing one
+                     * means a truncated/damaged input, which would yield WRONG dependencies. */
+                    fmt::print(stderr, "Error: {} does not end with a newline (truncated input?)\n", purgedname);
+                    exit(EXIT_FAILURE);
+                }
+                break;
+            }
+            if (last) {
+                cut = last + 1 - C->buf.get();
+                break;
+            }
+            C->reserve(2 * C->cap);   /* line longer than the chunk */
+        }
+        if (cut < C->len) {
+            carry.assign(C->buf.get() + cut, C->buf.get() + C->len);
+            C->len = cut;
+        }
+        if (C->len == 0) {
+            pool.put(std::move(C));
+            continue;
+        }
+        /* count relation lines, exactly as filter_rels() numbers them */
+        uint64_t n = 0;
+        {
+            char const * p = C->buf.get();
+            char const * const e = p + C->len;
+            while (p < e) {
+                if (is_rel_line(*p)) n++;
+                char const * nl = (char const *) memchr(p, '\n', e - p);
+                if (!nl) break;
+                p = nl + 1;
+            }
+        }
+        C->base = nrels;
+        C->nrels = n;
+        nrels += n;
+        todo.put(std::move(C));
+    }
+    todo.close();
+    for (auto & t : workers) t.join();
+
+    double const dt = wct_seconds() - t0;
+    printf("# Done: Read %" PRIu64 " relations in %.1fs -- %.1f MB/s -- %.1f rels/s\n",
+            nrels, dt, (double) G.nbytes / 1.0e6 / dt, (double) nrels / dt);
+    fflush(stdout);
+    if (overflow) {
+        fmt::print(stderr, "Error: {} has more relations ({}) than announced in its header ({})\n",
+                purgedname, nrels, nrows);
+        exit(EXIT_FAILURE);
+    }
+    if (nrels != nrows) {
+        /* RSA-530: fewer relations than the header announces = truncated input -> wrong dependencies */
+        fmt::print(stderr, "Error: {} announces {} relations but contains {} (truncated input?)\n",
+                purgedname, nrows, nrels);
+        exit(EXIT_FAILURE);
+    }
+    return res;
+}
+
+static blockmatrix small_character_matrix(blockmatrix const & bcmat,
+        index_csr const & I, int nthreads)
+{
+    unsigned int const nchars2 = bcmat.ncols();
+    uint64_t const small_nrows = I.nrows;
+    blockmatrix res(small_nrows, nchars2);
+    res.set_zero();
+    uint64_t const bnrows = bcmat.nrows();
+    std::atomic<uint64_t> bad { 0 };
+
+    auto work = [&](uint64_t i0, uint64_t i1) {
+        for (uint64_t i = i0; i < i1; i++) {
+            for(unsigned int cg = 0 ; cg < nchars2 ; cg+=64) {
+                uint64_t acc = 0;
+                for (uint64_t k = I.off[i]; k < I.off[i + 1]; k++) {
+                    uint32_t const col = I.cols[k];
+                    if (col >= bnrows) { bad++; continue; }
+                    acc ^= bcmat[col][cg];
+                }
+                res[i][cg] = acc;
+            }
+        }
+    };
+    /* row ranges aligned on 64 so that no two threads share a block row */
+    uint64_t const nblk = iceildiv(small_nrows, 64);
+    int const nt = (int) std::max<uint64_t>(1, std::min<uint64_t>(nthreads, nblk));
+    std::vector<std::thread> th;
+    for (int t = 0; t < nt; t++) {
+        uint64_t const i0 = std::min<uint64_t>(small_nrows, 64 * (nblk * t / nt));
+        uint64_t const i1 = std::min<uint64_t>(small_nrows, 64 * (nblk * (t + 1) / nt));
+        th.emplace_back(work, i0, i1);
+    }
+    for (auto & t : th) t.join();
+    ASSERT_ALWAYS(bad == 0);
+    return res;
+}
+
+static bool usable(const char * purgedname, const char * indexname, bool largeab)
+{
+    if (largeab) return false;
+    const char * env = getenv("CADO_CHARS_STOCK");
+    if (env && *env && strcmp(env, "0") != 0) return false;
+    /* gzread handles gzip and plain files; leave other codecs to the stock path */
+    for (const char * s : { ".bz2", ".xz", ".lzma", ".zst", ".zstd", ".lz4" }) {
+        if (has_suffix(purgedname, s) || has_suffix(indexname, s))
+            return false;
+    }
+    return true;
+}
