+/* {{{ fast parallel path (RSA-530 patch)
+ *
+ * The stock path above funnels every relation through filter_rels(): an
+ * external "gzip -dc" pipe, then a single-threaded line splitter/parser,
+ * then the character evaluation. At c160 (36M purged relations, 4 GB of
+ * text) that runs at ~110k rels/s (~330 s) on 4 of 16 cores.
+ *
+ * Here: one thread inflates the purged file in-process with zlib (gzread
+ * also passes uncompressed files through, e.g. a memfd path) into 8 MB
+ * line-aligned chunks and numbers the relations exactly as filter_rels()
+ * does (every line that does not start with '#' or '\n' gets the next
+ * number); nthreads workers parse a,b with the SAME ab_block parser and
+ * call the SAME eval_64chars() on the SAME character list, writing row
+ * rel.num of the big character matrix. Concurrently, another thread reads
+ * the index file into memory, so the small character matrix is then a
+ * parallel XOR pass. The resulting matrices are bit-for-bit those of the
+ * stock code, hence so is the output kernel file.
+ *
+ * Set CADO_CHARS_STOCK=1 in the environment to force the stock path.
+ */
+namespace fastchars {
+
+struct gz_reader {
+    gzFile f = nullptr;
+    std::string name;
+    uint64_t nbytes = 0;
+    explicit gz_reader(const char * fn) : name(fn) {
+        f = gzopen(fn, "rb");
+        if (f == nullptr) {
+            fmt::print(stderr, "Error: cannot open {}: {}\n", fn, strerror(errno));
+            exit(EXIT_FAILURE);
+        }
+        gzbuffer(f, 1U << 22);
+    }
+    gz_reader(gz_reader const &) = delete;
+    gz_reader & operator=(gz_reader const &) = delete;
+    ~gz_reader() { if (f) gzclose(f); }
+    /* read up to n bytes; short count only at end of file */
+    size_t read(char * dst, size_t n) {
+        size_t got = 0;
+        while (got < n) {
+            unsigned int const want = (unsigned int) std::min<size_t>(n - got, 1U << 30);
+            int const r = gzread(f, dst + got, want);
+            if (r < 0) {
+                int e;
+                fmt::print(stderr, "Error: gzread({}): {}\n", name, gzerror(f, &e));
+                exit(EXIT_FAILURE);
+            }
+            if (r == 0) {
+                int e;
+                const char * msg = gzerror(f, &e);
+                if (e != Z_OK && e != Z_BUF_ERROR) {
+                    fmt::print(stderr, "Error: gzread({}): {}\n", name, msg);
+                    exit(EXIT_FAILURE);
+                }
+                if (e == Z_BUF_ERROR) {
+                    /* zlib reports a truncated gzip stream this way */
+                    fmt::print(stderr, "Error: gzread({}): truncated input: {}\n", name, msg);
+                    exit(EXIT_FAILURE);
+                }
+                break;
+            }
+            got += r;
+        }
+        nbytes += got;
+        return got;
+    }
+};
+
+template<typename T>
+struct bqueue {
+    std::mutex mx;
+    std::condition_variable cv;
+    std::deque<T> q;
+    bool closed = false;
+    void put(T x) {
+        std::lock_guard<std::mutex> const lk(mx);
+        q.push_back(std::move(x));
+        cv.notify_one();
+    }
+    bool get(T & x) {
+        std::unique_lock<std::mutex> lk(mx);
+        cv.wait(lk, [&]{ return !q.empty() || closed; });
+        if (q.empty()) return false;
+        x = std::move(q.front());
+        q.pop_front();
+        return true;
+    }
+    void close() {
+        std::lock_guard<std::mutex> const lk(mx);
+        closed = true;
+        cv.notify_all();
+    }
+};
+
+struct chunk {
+    std::unique_ptr<char[]> buf;
+    size_t cap = 0;
+    size_t len = 0;
+    uint64_t base = 0;     /* number of the first relation in the chunk */
+    uint64_t nrels = 0;
+    void reserve(size_t n) {
+        if (cap >= n) return;
+        std::unique_ptr<char[]> nb(new char[n]);
+        if (len) memcpy(nb.get(), buf.get(), len);
+        buf = std::move(nb);
+        cap = n;
+    }
+};
+
+static inline bool is_rel_line(char c) { return c != '#' && c != '\n'; }
+
+/* {{{ index file, parsed in memory (same grammar as the fscanf calls of
+ * small_character_matrix: "%" SCNu64, then per row "%d" and that many "%x") */
+struct index_csr {
+    uint64_t nrows = 0;
+    std::vector<uint64_t> off;
+    std::vector<uint32_t> cols;
+};
+
+struct char_reader {
+    gz_reader g;
+    std::unique_ptr<char[]> b;
+    size_t pos = 0, len = 0;
+    static constexpr size_t CAP = 1U << 22;
+    explicit char_reader(const char * fn) : g(fn), b(new char[CAP]) {}
+    inline int get() {
+        if (pos == len) {
+            len = g.read(b.get(), CAP);
+            pos = 0;
+            if (len == 0) return EOF;
+        }
+        return (unsigned char) b[pos++];
+    }
+    inline int peek_after_ws() {
+        int c;
+        do { c = get(); } while (c == ' ' || c == '\n' || c == '\t' || c == '\r' || c == '\v' || c == '\f');
+        return c;
+    }
+    /* read an unsigned integer in base 10 or 16 */
+    template<unsigned int base>
+    uint64_t number(const char * what, uint64_t row) {
+        using cado::relation_building_blocks::ugly;
+        int c = peek_after_ws();
+        uint64_t w = 0;
+        unsigned int v;
+        int nd = 0;
+        for( ; c != EOF && (v = ugly[c]) < base ; c = get(), nd++) {
+            w = w * base + v;
+        }
+        if (nd == 0) {
+            fmt::print(stderr, "Error: index file {}: cannot parse {} at row {}\n",
+                    g.name, what, row);
+            exit(EXIT_FAILURE);
+        }
+        if (c != EOF && !(c == ' ' || c == '\n' || c == '\t' || c == '\r' || c == '\v' || c == '\f')) {
+            fmt::print(stderr, "Error: index file {}: unexpected character '{}' after {} at row {}\n",
+                    g.name, (char) c, what, row);
+            exit(EXIT_FAILURE);
+        }
+        return w;
+    }
+};
+
+static void read_index(const char * indexname, index_csr & I)
+{
+    char_reader R(indexname);
+    I.nrows = R.number<10>("row count", 0);
+    I.off.assign(I.nrows + 1, 0);
+    I.cols.reserve(I.nrows * 16);
+    for (uint64_t i = 0; i < I.nrows; i++) {
+        uint64_t const nc = R.number<10>("row weight", i);
+        ASSERT_ALWAYS(nc <= (uint64_t) INT_MAX);
+        for (uint64_t k = 0; k < nc; k++) {
+            uint64_t const col = R.number<16>("column", i);
+            ASSERT_ALWAYS(col <= UINT32_MAX);
+            I.cols.push_back((uint32_t) col);
+        }
+        I.off[i + 1] = I.cols.size();
+    }
+}
