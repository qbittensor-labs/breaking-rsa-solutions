+				logprintf(obj, "error: cannot locate "
+						"relation %u\n", 
+						c->cycle.list[j]);
+				exit(-1);
+			}
+			else {
+				c->cycle.list[j] = t->rel_idx;
+			}
+		}
+	}
+
+	dump_cycles(obj, cycle_list, num_cycles);
+	free_cycle_list(cycle_list, num_cycles);
+	free(convert);
+}
