+static int bsearch_relconvert(const void *key, const void *t) {
+	relconvert_t *c = (relconvert_t *)t;
+	uint32 *k = (uint32 *)key;
+
+	if ((*k) < c->purge_idx)
+		return -1;
+	if ((*k) > c->purge_idx)
+		return 1;
+	return 0;
+}
