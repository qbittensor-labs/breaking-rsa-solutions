+	/* ---- PARALLEL ROW REMAP (2026-08-21) --------------------------------
+	   ~4.3 M columns x ~92 entries on c151: 400 M scattered lookups plus one
+	   small qsort per column. It is the largest remaining serial block in
+	   -nc2's reduce/count/dump phase (Worth-Try.md §2a: 32 s), and -nc2 is the
+	   biggest CPU-exposed stage of an otherwise GPU-bound run, so a
+	   slower-single-core validator host is charged all of it.
+
+	   Unlike everything else in reduce_matrix this loop carries NO order
+	   dependence at all: column i reads only old_counts (read-only here) and
+	   writes only its own col->data, and the qsort sorts that column alone.
+	   The result is therefore identical for any thread count, by construction
+	   rather than by argument -- which is what lets it be threaded while the
+	   singleton/clique cascade below stays strictly serial.
+
+	   obj->num_threads is msieve's own -t, so -t 1 walks this with one thread. */
+	{
+		int32 ci;
+		uint32 nthreads = obj->num_threads ? obj->num_threads : 1;
+		if (nthreads > 64)
+			nthreads = 64;
+		#pragma omp parallel for schedule(dynamic, 4096) \
+					num_threads(nthreads)
+		for (ci = 0; ci < (int32)reduced_cols; ci++) {
+			la_col_t *col = cols + ci;
+			uint32 jj;
+			for (jj = 0; jj < col->weight; jj++) {
+				col->data[jj] = old_counts[col->data[jj]].index;
+			}
+			qsort(col->data, (size_t)col->weight,
+					sizeof(uint32), compare_uint32);
 		}
-		qsort(col->data, (size_t)col->weight, 
-				sizeof(uint32), compare_uint32);
 	}
