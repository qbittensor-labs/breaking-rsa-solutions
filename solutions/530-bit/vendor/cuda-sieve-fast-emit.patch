+/* ---- fast line emit (rsa530 patch, 2026-09-27) --------------------------- *
+ * The host join loop formatted every relation/candidate with ~20 fprintf calls and a 12-limb
+ * bn_to_dec per cofactor: measured 0.84-1.13 ms per special-q on the c160 (a c160 q has ~600
+ * candidates), during which the GPU idles. Same bytes, built in a local buffer and written with
+ * one fwrite. Cofactors that do not fit 64 bits keep the original bn_to_dec path. */
+static char *fe_u64(char *p, uint64_t v)
+{
+    char t[24]; int n = 0;
+    do { t[n++] = (char)('0' + v % 10u); v /= 10u; } while (v);
+    while (n) *p++ = t[--n];
+    return p;
+}
+static char *fe_i64(char *p, int64_t v)
+{
+    if (v < 0) { *p++ = '-'; return fe_u64(p, (uint64_t)0 - (uint64_t)v); }
+    return fe_u64(p, (uint64_t)v);
+}
+static char *fe_hex(char *p, uint64_t v)
+{
+    static const char H[] = "0123456789abcdef";
+    char t[20]; int n = 0;
+    do { t[n++] = H[v & 15u]; v >>= 4; } while (v);
+    while (n) *p++ = t[--n];
+    return p;
+}
+static inline int fe_bn_u64(const bn_t *x, uint64_t *out)
+{
+    for (int i = 2; i < BN_LIMBS; i++) if (x->v[i]) return 0;
+    *out = (uint64_t)x->v[0] | ((uint64_t)x->v[1] << 32);
+    return 1;
+}
