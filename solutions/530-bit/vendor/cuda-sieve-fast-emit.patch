+static void fe_start(FILE *fr, FILE *fc)
+{
+    if (g_fe.on) return;
+    g_fe.fr = fr; g_fe.fc = fc; g_fe.stop = false; g_fe.busy = false; g_fe.q.clear();
+    try { g_fe.th = std::thread(fe_worker); g_fe.on = true; }
+    catch (...) {   /* e.g. EAGAIN under a pids limit: keep the synchronous path (g_fe.on stays false) */
+        fprintf(stderr, "  warning: async emit thread unavailable; synchronous join-loop output\n");
+    }
+}
+static void fe_drain(void)
+{
+    if (!g_fe.on) return;
+    std::unique_lock<std::mutex> l(g_fe.m);
+    g_fe.cv_idle.wait(l, [] { return g_fe.q.empty() && !g_fe.busy; });
+}
+static void fe_stop(void)
+{
+    if (!g_fe.on) return;
+    fe_drain();
+    { std::lock_guard<std::mutex> l(g_fe.m); g_fe.stop = true; }
+    g_fe.cv.notify_all();
+    g_fe.th.join(); g_fe.on = false; g_fe.fr = g_fe.fc = NULL;
+}
+static void fe_submit(std::vector<uint32_t> &batch)
+{
+    if (batch.empty()) return;
+    { std::lock_guard<std::mutex> l(g_fe.m); g_fe.q.emplace_back(); g_fe.q.back().swap(batch); }
+    g_fe.cv.notify_one();
+    batch.clear();
