+static void fe_worker(void)
+{
+    std::string rb, cb;
+    for (;;) {
+        std::vector<uint32_t> batch;
+        {
+            std::unique_lock<std::mutex> l(g_fe.m);
+            g_fe.cv.wait(l, [] { return g_fe.stop || !g_fe.q.empty(); });
+            if (g_fe.q.empty()) return;              /* stop requested and nothing left */
+            batch.swap(g_fe.q.front()); g_fe.q.pop_front(); g_fe.busy = true;
+        }
+        rb.clear(); cb.clear();
+        fe_format(batch, rb, cb);
+        if (!rb.empty() && g_fe.fr) fwrite(rb.data(), 1, rb.size(), g_fe.fr);   /* errors: ferror() at close */
+        if (!cb.empty() && g_fe.fc) fwrite(cb.data(), 1, cb.size(), g_fe.fc);
+        {
+            std::lock_guard<std::mutex> l(g_fe.m);
+            g_fe.busy = false;
+            if (g_fe.q.empty()) g_fe.cv_idle.notify_all();
