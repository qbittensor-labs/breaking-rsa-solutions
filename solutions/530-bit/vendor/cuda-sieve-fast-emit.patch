+        const int has0 = (w0 >> 24) & 1, has1 = (w0 >> 25) & 1, neg0 = (w0 >> 26) & 1, neg1 = (w0 >> 27) & 1;
+        const int64_t a = (int64_t)((uint64_t)B[i + 1] | ((uint64_t)B[i + 2] << 32));
+        const int64_t b = (int64_t)((uint64_t)B[i + 3] | ((uint64_t)B[i + 4] << 32));
+        const uint64_t u0 = (uint64_t)B[i + 5] | ((uint64_t)B[i + 6] << 32);
+        const uint64_t u1 = (uint64_t)B[i + 7] | ((uint64_t)B[i + 8] << 32);
+        i += 9;
+        for (uint32_t z = 0; z < c0; z++) f[0][z] = B[i + z];
+        i += c0;
+        for (uint32_t z = 0; z < c1; z++) f[1][z] = B[i + z];
+        i += c1;
