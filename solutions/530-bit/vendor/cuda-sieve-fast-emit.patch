+/* ---- async emit (rsa530 patch 2, 2026-09-27) -------------------------------- *
+ * Without --cofactor the host join loop sorted + formatted + wrote ~770 lines per special-q on the
+ * pipeline's own thread (0.40 ms/q even with the fast formatter) while the GPU idled. The loop now
+ * only PACKS each line's raw fields (a few dozen words) into a batch; one writer thread sorts,
+ * formats and fwrites them in FIFO order, so the files are byte-identical. Every flush/tell/close
+ * of the two streams goes through pipe_checkpoint or pipe_finalize_outputs, and both drain the
+ * writer first (fe_drain / fe_stop), so checkpoint offsets always cover exactly the bytes emitted.
+ * Packed record (uint32 words): w0 = kind(0 rel,1 cand) | c0<<8 | c1<<16 | has0<<24 | has1<<25 |
+ * neg0<<26 | neg1<<27; a (2 words), b (2), cof0 (2), cof1 (2); then c0 + c1 UNSORTED factors. */
+#include <thread>
+#include <mutex>
+#include <condition_variable>
+#include <deque>
+#include <vector>
+#include <string>
+typedef struct fe_async_s {
+    std::thread th; std::mutex m; std::condition_variable cv, cv_idle;
+    std::deque<std::vector<uint32_t> > q; bool stop, busy, on;
+    FILE *fr, *fc;
