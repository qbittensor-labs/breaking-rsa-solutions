+            for (uint32_t z = 0; z < c0; z++) { if (z) *q++ = ','; q = fe_hex(q, f[0][z]); }
+            if (has0) { if (c0) *q++ = ','; q = fe_hex(q, u0); }
+            *q++ = ':';
+            for (uint32_t z = 0; z < c1; z++) { if (z) *q++ = ','; q = fe_hex(q, f[1][z]); }
+            if (has1) { if (c1) *q++ = ','; q = fe_hex(q, u1); }
+            *q++ = '\n';
+            rb.append(ln, (size_t)(q - ln));
+        } else {
+            if (neg0) *q++ = '-';
+            q = fe_u64(q, u0); *q++ = ',';
+            if (neg1) *q++ = '-';
+            q = fe_u64(q, u1); *q++ = ':';
+            q = fe_i64(q, a); *q++ = ','; q = fe_i64(q, b); *q++ = ':';
+            for (uint32_t z = 0; z < c0; z++) { if (z) *q++ = ','; q = fe_hex(q, f[0][z]); }
+            *q++ = ':';
+            for (uint32_t z = 0; z < c1; z++) { if (z) *q++ = ','; q = fe_hex(q, f[1][z]); }
