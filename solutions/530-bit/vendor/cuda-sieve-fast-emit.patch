+static fe_async_t g_fe;
+static char *fe_u64(char *p, uint64_t v);
+static char *fe_i64(char *p, int64_t v);
+static char *fe_hex(char *p, uint64_t v);
+static void fe_format(const std::vector<uint32_t> &B, std::string &rb, std::string &cb)
+{
+    char ln[128 + 20 * (2 * 64 + 2)];
+    uint32_t f[2][64];
+    size_t i = 0;
+    while (i < B.size()) {
+        const uint32_t w0 = B[i];
